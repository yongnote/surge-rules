#!name=Shadowrocket AD Only (Surge)
#!desc=Weekly upstream conversion; may cause false positives.
# Source: https://johnshall.github.io/Shadowrocket-ADBlock-Rules-Forever/sr_ad_only.conf
# Attribution: Johnshall/Shadowrocket-ADBlock-Rules-Forever, based on h2y/Shadowrocket-ADBlock-Rules.
# License: CC BY-SA 4.0 https://creativecommons.org/licenses/by-sa/4.0/
# Changes: external rule set, canonical IP networks, and no-resolve for IP rules.

[Rule]
RULE-SET,https://raw.githubusercontent.com/yongnote/surge-rules/main/sr_ad_only.list,REJECT

[URL Rewrite]
# Zhihu launch ads; HTTPS decryption for api.zhihu.com is opt-in in the profile.
^https://api\.zhihu\.com/commercial_api/launch_v2/?(?:[?#]|$) _ reject
^https://api\.zhihu\.com/commercial_api/real_time_launch_v2/?(?:[?#]|$) _ reject
